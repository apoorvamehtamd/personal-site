---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Apoorva Mehta, MD, MBA",
	description = "Trained to be a physician. Spend my time building & investing in AI, healthcare, & life sciences.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og.png", Astro.site);

const isHome = Astro.url.pathname === "/";

// Declared once, on the homepage only, so search engines resolve the site to a
// single Person entity rather than one per page. No jobTitle on purpose — the
// brand leads with the identity statement, not a title.
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Apoorva Mehta",
	honorificSuffix: "MD, MBA",
	description:
		"Trained to be a physician. Spend my time building & investing in AI, healthcare, & life sciences.",
	url: Astro.site?.href,
	image: ogImageURL.href,
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "Columbia University",
	},
	sameAs: [
		"https://linkedin.com/in/apoorvamehtamd",
		"https://x.com/apoorvamehtamd",
	],
};

const nav = [
	{ href: "/", label: "Home" },
	{ href: "/track-record", label: "Track Record" },
	{ href: "/research", label: "Research" },
	{ href: "/now", label: "Now" },
	{ href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		{isHome && (
			<script
				type="application/ld+json"
				set:html={JSON.stringify(personSchema)}
			/>
		)}
	</head>
	<body>
		<header class="site wrap">
			<div class="brand-row">
				<a class="brand" href="/">Apoorva Mehta, MD, MBA</a>
				<span class="social">
					<a
						href="https://linkedin.com/in/apoorvamehtamd"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
					>
						<svg viewBox="0 0 24 24" fill="currentColor">
							<path
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
							></path>
						</svg>
					</a>
					<a
						href="https://x.com/apoorvamehtamd"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="X"
					>
						<svg viewBox="0 0 24 24" fill="currentColor">
							<path
								d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
							></path>
						</svg>
					</a>
				</span>
			</div>
			<nav class="site">
				{nav.filter((item) => item.href !== "/").map((item) => (
					<a
						href={item.href}
						aria-current={path === item.href ? "page" : undefined}
					>
						{item.label}
					</a>
				))}
			</nav>
		</header>
		<main class="wrap">
			<slot />
		</main>
	</body>
</html>
