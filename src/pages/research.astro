---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { extractSection } from "../lib/publications";

const raw = fs.readFileSync(
	path.resolve(process.cwd(), "PUBLICATIONS.md"),
	"utf-8",
);

const peerReviewed = extractSection(raw, "Peer-Reviewed Publications");

// Order these four intentionally, independent of PUBLICATIONS.md's
// reverse-chronological order — see CLAUDE.md Research section.
const order = [
	"Deep Learning Image Processing Models in Dermatopathology",
	"Divergent impacts of explainable AI",
	"LLM-Based Explainable Medical AI",
	"Retrieval Augmented Generation-Enabled Large Language Model for Risk Stratification",
];

const featured = order.map((key) =>
	peerReviewed.find((entry) => entry.featured && entry.html.includes(key)),
);
---

<Layout title="Research — Apoorva Mehta, MD, MBA">
	<h1>Research</h1>
	<p>
		40+ peer-reviewed publications and presentations spanning clinical AI,
		dermatology, and digital health.
	</p>

	<ol class="pub-list">
		{featured.map((entry) =>
			entry ? (
				<li>
					<span set:html={entry.html} />
					{entry.doi && (
						<div class="meta">
							<a
								class="doi-link"
								href={`https://doi.org/${entry.doi}`}
							>
								doi.org/{entry.doi}
							</a>
						</div>
					)}
				</li>
			) : null,
		)}
	</ol>

	<p><a href="/publications">See the full list of publications →</a></p>
</Layout>
