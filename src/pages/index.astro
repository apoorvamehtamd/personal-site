---
import Layout from "../layouts/Layout.astro";

const links = [
	{ href: "/now", label: "Now" },
	{ href: "/track-record", label: "Track Record" },
	{ href: "/research", label: "Research" },
	{ href: "/mehta-ventures", label: "Mehta Ventures" },
	{ href: "/contact", label: "Contact" },
];
---

<Layout>
	<p class="hero">
		MD, MBA by training. Founder &amp; investor by instinct — always
		thinking about what's next.
	</p>
	<div class="proof-row">
		<span><strong>40+</strong> publications</span>
		<span><strong>100K+</strong> users grown</span>
		<span><strong>100s</strong> of startups diligenced</span>
	</div>
	<p>
		I'm a physician trained at Columbia, currently completing residency
		before dermatology training at the University of Maryland. Alongside
		medicine, I've co-founded a health-tech company, evaluated hundreds of
		digital health startups in venture, and helped grow an early-stage
		platform to six figures of users — and I'm now building{" "}
		<a href="/mehta-ventures">Mehta Ventures</a>.
	</p>

	<div class="links">
		{links.map((l) => <a href={l.href}>{l.label}</a>)}
	</div>
</Layout>
