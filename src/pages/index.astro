---
import Layout from "../layouts/Layout.astro";

const links = [
	{ href: "/track-record", label: "Track Record" },
	{ href: "/research", label: "Research" },
	{ href: "/now", label: "Now" },
	{ href: "/contact", label: "Contact" },
];
---

<Layout>
	<p class="hero">
		Physician, researcher, and builder — always learning, always
		exploring what's next.
	</p>
	<p>
		I'm a physician, currently completing residency at Mount Sinai
		Elmhurst before dermatology training at the University of Maryland.
		Alongside medicine, I've spent time building — co-founding a
		health-tech company, evaluating early-stage startups in venture, and
		helping grow a digital health platform from the ground up. Along the
		way, I've published 40+ peer-reviewed papers in clinical AI and
		dermatology.
	</p>
	<p>
		I'm always learning, always exploring what's next, and always glad to
		connect with others working in health and AI.
	</p>

	<div class="links">
		{links.map((l) => <a href={l.href}>{l.label}</a>)}
	</div>
</Layout>
