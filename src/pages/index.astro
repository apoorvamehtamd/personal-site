---
import Layout from "../layouts/Layout.astro";

const links = [
	{ href: "/track-record", label: "Track Record" },
	{ href: "/mehta-ventures", label: "Mehta Ventures" },
	{ href: "/research", label: "Research" },
	{ href: "/now", label: "Now" },
	{ href: "/contact", label: "Contact" },
];
---

<Layout>
	<p class="hero">
		MD, MBA by training. Founder &amp; investor by instinct — always
		thinking about what's next.
	</p>
	<div class="proof-row">
		<span><strong>40+</strong> publications</span>
		<span><strong>100K+</strong> users grown</span>
		<span><strong>100s</strong> of startups diligenced</span>
	</div>
	<p>
		I've co-founded a health-tech company, evaluated hundreds of digital
		health startups in venture, and helped grow an early-stage platform to
		six figures of users — and I'm now building{" "}
		<a href="/mehta-ventures">Mehta Ventures</a>. Unusually for an operator,
		I'm also a practicing physician — Columbia-trained, completing
		residency before dermatology at Maryland — with 40+ peer-reviewed
		papers in clinical AI and dermatology along the way.
	</p>

	<div class="links">
		{links.map((l) => <a href={l.href}>{l.label}</a>)}
	</div>
</Layout>
