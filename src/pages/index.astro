---
import Layout from "../layouts/Layout.astro";

const links = [
	{ href: "/track-record", label: "Track Record" },
	{ href: "/research", label: "Research" },
	{ href: "/now", label: "Now" },
	{ href: "/contact", label: "Contact" },
];
---

<Layout>
	<p class="hero">
		One of the few people building healthcare AI who's also treated
		patients — always exploring what's next.
	</p>
	<p>
		I've spent time building — co-founding a company building long-horizon
		reinforcement learning environments for healthcare, evaluating
		early-stage startups in venture, and helping grow a digital health
		platform from the ground up. I'm also a physician, completing
		residency at Mount Sinai Elmhurst before dermatology training at the
		University of Maryland, with 40+ peer-reviewed papers in clinical AI
		and dermatology along the way.
	</p>
	<p>
		I'm always learning, always exploring what's next, and always glad to
		connect with others working in health and AI.
	</p>

	<div class="links">
		{links.map((l) => <a href={l.href}>{l.label}</a>)}
	</div>
</Layout>
