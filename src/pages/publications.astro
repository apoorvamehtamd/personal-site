---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { extractSection } from "../lib/publications";

// process.cwd() is the project root for both `astro dev` and `astro build`
// (import.meta.url isn't reliable here since bundling relocates this chunk).
const raw = fs.readFileSync(
	path.resolve(process.cwd(), "PUBLICATIONS.md"),
	"utf-8",
);

const peerReviewed = extractSection(raw, "Peer-Reviewed Publications");
const oral = extractSection(raw, "Oral Presentations");
const posters = extractSection(raw, "Poster Presentations");

const sections = [
	{ title: "Peer-Reviewed Publications", entries: peerReviewed },
	{ title: "Oral Presentations", entries: oral },
	{ title: "Poster Presentations", entries: posters },
];
---

<Layout title="Publications — Apoorva Mehta, MD, MBA">
	<h1>Publications</h1>
	<p>
		Complete list of peer-reviewed publications and presentations, in
		reverse chronological order within each section. ★ marks first-author
		work; 🏠 marks work also featured on the <a href="/research"
			>Research</a
		> page.
	</p>

	{sections.map((section) => (
		<>
			<h2>{section.title}</h2>
			<ol class="pub-list">
				{section.entries.map((entry) => (
					<li>
						<span class="pub-tags">
							{entry.firstAuthor && (
								<span class="tag" title="First author">
									★
								</span>
							)}
							{entry.featured && (
								<span class="tag" title="Featured on homepage">
									🏠
								</span>
							)}
						</span>
						<span class="pub-entry">
							<span set:html={entry.html} />
							{entry.doi && (
								<div class="meta">
									<a
										class="doi-link"
										href={`https://doi.org/${entry.doi}`}
									>
										doi.org/{entry.doi}
									</a>
								</div>
							)}
						</span>
					</li>
				))}
			</ol>
		</>
	))}
</Layout>
